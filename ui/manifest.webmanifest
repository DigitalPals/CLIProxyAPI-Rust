{
  "id": "/",
  "name": "Fusebox",
  "short_name": "Fusebox",
  "description": "All your AI subscriptions, one fast API: accounts, quota, live traffic and what has tripped.",
  "start_url": "/#/overview",
  "scope": "/",
  "display": "standalone",
  "background_color": "#0b0b0a",
  "theme_color": "#0b0b0a",
  "lang": "en",
  "dir": "ltr",
  "categories": ["developer", "utilities"],
  "icons": [
    { "src": "/ui/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/ui/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/ui/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/ui/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "Accounts", "url": "/#/accounts", "icons": [{ "src": "/ui/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Requests", "url": "/#/requests", "icons": [{ "src": "/ui/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Usage", "url": "/#/usage", "icons": [{ "src": "/ui/icons/icon-192.png", "sizes": "192x192" }] }
  ],
  "launch_handler": { "client_mode": ["focus-existing", "auto"] }
}
